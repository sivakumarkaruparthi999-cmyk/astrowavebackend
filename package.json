{
  "name": "astrotalk-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Centralized AstroTalk Backend API with PostgreSQL, MongoDB, JWT Auth, and Socket.IO",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && cp src/migrations/*.sql dist/migrations/ 2>/dev/null || true",
    "prestart": "node dist/migrations/migrate.js && node dist/scripts/create-admin.js",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrations/migrate.ts",
    "migrate:rollback": "tsx src/migrations/rollback.ts",
    "mongo:indexes": "tsx src/migrations/init-mongo-indexes.ts",
    "create:admin": "tsx src/scripts/create-admin.ts",
    "seed:dev": "tsx src/migrations/seed.ts",
    "test": "npm run test:backend && npm run test:razorpay && npm run test:readiness && npm run test:socket && npm run test:phase2 && npm run test:phase3 && npm run test:firebase",
    "test:backend": "NODE_ENV=test tsx --test test/backend.test.ts",
    "test:readiness": "NODE_ENV=test tsx --test test/production-readiness.test.ts",
    "test:phase2": "NODE_ENV=test tsx --test test/phase2-database-payment.test.ts",
    "test:phase3": "NODE_ENV=test tsx --test test/phase3-calls.test.ts",
    "test:razorpay": "NODE_ENV=test tsx --test test/razorpay-payments.test.ts",
    "test:socket": "NODE_ENV=test tsx --test test/socket-duplicate-message.test.ts",
    "test:firebase": "NODE_ENV=test tsx --test test/firebase-auth.test.ts",
    "test:backup-restore": "tsx src/scripts/test-backup-restore.ts",
    "test:secret-rotation": "NODE_ENV=test tsx --test test/secret-rotation-dryrun.test.ts",
    "test:resilience": "NODE_ENV=test tsx --test test/financial-and-session-resilience.test.ts",
    "test:e2e": "tsx --test test/e2e-audit.ts"
  },
  "dependencies": {
    "@sentry/node": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.14.0",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "rate-limit-redis": "^6.0.1",
    "razorpay": "^2.9.8",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
