# Node Environment
NODE_ENV=production
PORT=5001

# PostgreSQL Connection (Set by Railway PostgreSQL plugin as DATABASE_URL)
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>
# Alternatively individual PG variables if not using DATABASE_URL:
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=astrotalk
# PGSSL=true

# MongoDB Connection (Set by Railway/Atlas as MONGODB_URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication Secrets (Generate secure random 64-char strings)
JWT_SECRET=your_production_jwt_access_secret_64_chars_min
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_64_chars_min
JWT_EXPIRY=1d
JWT_REFRESH_EXPIRY=30d

# WebRTC ICE & TURN Configuration (RFC 5766 / RFC 8656)
TURN_URL=turn:turn.example.com:3478?transport=udp
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential_secret

# CORS Allowed Origins (Comma-separated list of production web origins)
CORS_ORIGINS=https://admin.example.com,https://example.com

# Service Base URL & Local Storage Directory
BASE_URL=https://api.example.com
STORAGE_PATH=./uploads

# Razorpay Payment Gateway (Live production keys only; RAZORPAY_MODE=test is forbidden in production)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_MODE=live

# Firebase Admin SDK (For mobile OTP & Firebase phone verification)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="your_firebase_private_key_escaped_pem_string"

# Optional: Google OAuth Client ID for mobile Google sign-in audience check
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Redis Distributed Cache & Rate Limiting (Optional - falls back to memory store if omitted)
REDIS_URL=redis://default:<password>@<host>:6379

# Error Monitoring (Sentry DSN - optional, falls back to structured logger if omitted)
SENTRY_DSN=https://<public_key>@<host>.ingest.sentry.io/<project_id>

# Observability Metadata
SERVICE_NAME=astrowave-api
APP_VERSION=1.0.0

# Optional: Initial Production Super Admin Seed (Used by npm run create:admin)
# ADMIN_EMAIL=admin@astrowave.com
# ADMIN_PASSWORD=your_initial_strong_admin_password

